# ──────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy to .env and fill in your values.
# DO NOT commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM Backend ───────────────────────────────────────────────────────────────
# Active backend: ollama | lmstudio | llamacpp | openai | anthropic
LLM_BACKEND=ollama

# ── Ollama (local, no API key needed) ─────────────────────────────────────────
LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_OLLAMA_MODEL=granite3.3:8b

# ── LM Studio (local, OpenAI-compatible) ──────────────────────────────────────
LLM_LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLM_LMSTUDIO_MODEL=local-model

# ── llama.cpp HTTP server ──────────────────────────────────────────────────────
LLM_LLAMACPP_BASE_URL=http://localhost:9931/v1
LLM_LLAMACPP_MODEL=granite

# ── OpenAI Cloud ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_OPENAI_MODEL=gpt-4o-mini

# ── Anthropic Cloud ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── Speech Model Settings ─────────────────────────────────────────────────────
# SPEECH_DEVICE=auto            # auto | cuda | mps | cpu
# SPEECH_DTYPE=auto             # auto | bfloat16 | float16 | float32
# SPEECH_MAX_NEW_TOKENS=512

# ── App Settings ──────────────────────────────────────────────────────────────
# APP_PORT=7860
# APP_LOG_LEVEL=INFO
